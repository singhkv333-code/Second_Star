# Server-only mail settings for every email Pivot sends (charto/data/mailer.py).
# Never put these in NEXT_PUBLIC_ variables or commit a password.
#
# Sends as contact@pivotnow.in through Hostinger, which hosts pivotnow.in's mail.
# pivotnow.in's SPF already authorises Hostinger and its DKIM key is Hostinger's
# (hostingermail-a), so these messages pass SPF, DKIM and DMARC with no DNS change.
CHARTO_MAIL_ENABLED=true
CHARTO_MAIL_FROM=contact@pivotnow.in
CHARTO_MAIL_USER=contact@pivotnow.in
CHARTO_MAIL_HOST=smtp.hostinger.com
CHARTO_MAIL_PORT=465
CHARTO_MAIL_PASSWORD_FILE=/etc/pivot/mail-password
CHARTO_PUBLIC_ORIGIN=https://app.pivotnow.in
# Secret file: the contact@pivotnow.in mailbox password from Hostinger hPanel.
# Owner root, group pivot-data, mode 0640. The old Gmail app password does not
# work here and should be revoked.
