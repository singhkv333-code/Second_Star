# Server-only. Never put these in NEXT_PUBLIC_ variables or commit a password.
CHARTO_ALERT_EMAIL_ENABLED=true
CHARTO_SMTP_USER=info@pivotnow.in
CHARTO_SMTP_PORT=465
CHARTO_SMTP_PASSWORD_FILE=/etc/pivot/alert-smtp-password
# Secret file: Google app password, owner root, group pivot-data, mode 0640.
# If info@ is a verified send-as alias, CHARTO_SMTP_USER is its owning mailbox.
# The From and envelope sender stay info@pivotnow.in.
