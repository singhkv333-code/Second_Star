# The base the BROWSER uses, so it must be an address the browser can reach.
#
# This was http://127.0.0.1:5174/api, which is correct only on the machine
# running the dataserver. NEXT_PUBLIC_* is inlined into the client bundle at
# build time, so the deployed page told every visitor's browser to call its
# OWN localhost — the company page in production has never loaded data.
#
# Relative, therefore: nginx proxies /api/ to the dataserver on the VM, and
# serve.py does the same in dev, so one value is right in both.
NEXT_PUBLIC_PIVOT_API_BASE=/api

# No live-quote socket. charto serves no /api/ws/quotes, so the client's
# derived wss://<host>/api/ws/quotes 404s on every attempt and then retries
# — an error loop in the console of a page whose prices are already current
# from the REST quote. Empty disables it rather than leaving it to guess.
NEXT_PUBLIC_PIVOT_WS_BASE=
