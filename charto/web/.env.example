# Server-only Azure PostgreSQL connection used by app/api/waitlist/route.ts.
# Set this in Vercel for Production and Preview; never prefix it NEXT_PUBLIC_.
WAITLIST_DATABASE_URL=

# Existing browser-side API base for the rest of Charto. The waitlist form
# does not use this value; it posts to the same-origin /api/waitlist route.
NEXT_PUBLIC_PIVOT_API_BASE=/api
NEXT_PUBLIC_PIVOT_WS_BASE=

# Server only; never prefix the secret with NEXT_PUBLIC_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Public key ID only (optional: checkout uses the server order response).
NEXT_PUBLIC_RAZORPAY_KEY_ID=
