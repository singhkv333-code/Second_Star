# ============================================================================
# Pivot backend — environment template
#
# Copy this file to `.env` and fill in values. `.env` is gitignored.
# Every key here mirrors a field on backend/config.py:Settings.
# ============================================================================

# --- Database -----------------------------------------------------------------
DATABASE_URL=postgresql://pivot_user:pivot_password@localhost:5432/pivot_db

# --- Redis --------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- JWT ----------------------------------------------------------------------
# Generate a strong secret:   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-48+-char-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Kite Connect (Zerodha) — leave empty for mock mode -----------------------
KITE_API_KEY=
KITE_API_SECRET=

# Fernet symmetric key used to encrypt KiteSession.access_token / request_token /
# totp_secret at rest. REQUIRED in production. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating this key invalidates every existing encrypted token in the DB.
KITE_TOKEN_ENC_KEY=

# --- AI providers — leave empty for mock mode --------------------------------
SARVAM_API_KEY=
OPENAI_API_KEY=

# LLM provider selection (backend/llm/factory.py)
#   LLM_PROVIDER: "openai" | "sarvam"
#   LLM_MODEL:    overrides the per-provider default; leave blank to keep it
LLM_PROVIDER=openai
LLM_MODEL=

# --- App ----------------------------------------------------------------------
APP_ENV=development
APP_VERSION=0.1.0
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
FRONTEND_URL=http://localhost:3000

# --- Observability (Phase 0) --------------------------------------------------
# Log format: "json" for production (one structured line per event), "console"
# for local dev (human-readable). Defaults to "console".
LOG_FORMAT=console
LOG_LEVEL=INFO

# Sentry error reporting. Leave empty to disable.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# PostHog analytics. Leave POSTHOG_PROJECT_TOKEN empty to disable (no-op client).
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com

# Google Sign-In — OAuth 2.0 **Web** client id from Google Cloud Console
# (APIs & Services → Credentials → Create OAuth client ID → Web application).
# Add http://localhost:3000 as an Authorized JavaScript origin (plus your
# prod domain). The SAME value goes in the frontend as
# NEXT_PUBLIC_GOOGLE_CLIENT_ID (pivot-next/.env.local). Leave empty to keep
# the "Login with Google" button in its "coming soon" fallback.
GOOGLE_CLIENT_ID=
