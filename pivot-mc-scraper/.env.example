# Postgres maintenance DSN (the bootstrap connects here, then creates `financials`).
# Default points at the Pivot dev Postgres.
PIVOT_PG_DSN=postgresql://pivot_user:pivot_password@localhost:5432/postgres

# The DB created by `mc-scraper init`. Workers connect here.
FINANCIALS_DB_NAME=financials

# Polite scraping
USER_AGENT_POOL="Mozilla/5.0 (Macintosh; Intel Mac OS X 14_5) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/17.5 Safari/605.1.15|Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0 Safari/537.36|Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0 Safari/537.36"
RATE_LIMIT=10
HTTP_TIMEOUT=20

# Refuse to start during Indian market hours (09:15–15:30 IST) unless --force is used.
RESPECT_MARKET_HOURS=true
