# Pivot chatbot endpoint (the live FastAPI backend the eval calls).
PIVOT_BASE_URL=http://127.0.0.1:8000

# Auth: either supply an existing bearer token, or login creds the runner uses.
PIVOT_BEARER_TOKEN=
PIVOT_LOGIN_EMAIL=smoke@example.com
PIVOT_LOGIN_PASSWORD=smokepass1

# Sarvam — used by the LLM judge for irreducibly subjective rubric items.
# Reuse the same key the chatbot uses; the judge prompt is anchored 1-3.
SARVAM_API_KEY=

# Concurrency for the runner. The chat endpoint should handle ~4 parallel.
PIVOT_EVAL_CONCURRENCY=4
