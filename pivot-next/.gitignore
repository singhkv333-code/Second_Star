# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*

# testing
/coverage

# next.js
/.next/
# A crashed build leaves the whole cache behind as `.next.corrupt-<stamp>/`,
# which the bare `/.next/` rule does not match — 182 MB of webpack cache
# went into a commit that way once.
/.next.corrupt-*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
