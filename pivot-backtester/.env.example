# DSN for the financials DB created by `mc-scraper init`.
FINANCIALS_DSN=postgresql://pivot_user:pivot_password@localhost:5432/financials

# Used only by tests: a maintenance DSN where they can CREATE/DROP scratch DBs.
PIVOT_PG_DSN=postgresql://pivot_user:pivot_password@localhost:5432/postgres

# Path to the pivot-mc-scraper sibling (tests apply its migrations to scratch DBs).
MC_SCRAPER_PATH=../pivot-mc-scraper

# Risk-free rate used by Sharpe/Sortino. India 10y benchmark, override as needed.
RISK_FREE_RATE=0.065
